{
  "manifest_version": 3,
  "name": "YouTube Summary (bring your own LLM)",
  "short_name": "YT Summary",
  "version": "0.1.0",
  "description": "One click: transcript, summary and chapter timeline for the YouTube video in this tab, using your own OpenAI-compatible endpoint.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Summarize this video", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "side_panel": { "default_path": "src/panel/panel.html" },
  "options_page": "src/options/options.html",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://*.googlevideo.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["src/page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.youtube.com/*"], "js": ["src/content.js"], "run_at": "document_idle" }
  ]
}
